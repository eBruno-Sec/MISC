# ── AI Provider (preferred: one clean generic format) ──────────
# Pick a provider, then set the three generic AI_* vars. That's all you need.
#   AI_PROVIDER   openrouter | anthropic
#   AI_API_KEY    your provider key
#   AI_MODEL      model id (optional; a safe per-provider default is used if empty)
#   AI_BASE_URL   API base (optional; defaults per provider)
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-...
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter free models with tool calling: meta-llama/llama-3.3-70b-instruct:free,
#   google/gemini-2.0-flash-exp:free, qwen/qwen3-235b-a22b:free
# For Anthropic: AI_PROVIDER=anthropic, AI_API_KEY=sk-ant-..., AI_MODEL=claude-sonnet-4-6
#   (leave AI_BASE_URL empty to use Anthropic's default endpoint).

# ── Provider-specific overrides (optional) ─────────────────────
# These take PRECEDENCE over the generic AI_* vars when set. Leave them unset
# unless you want to override a single field for one provider.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── HITL intrusive-gate timeout ────────────────────────────────
# Seconds before an unanswered intrusive-probing approval auto-denies.
# 0 = wait forever (default). Set e.g. 300 for a 5-minute auto-deny.
BBH_APPROVAL_TIMEOUT=0

# ── Persistence ────────────────────────────────────────────────
# SQLite database path (mounted volume). Default is fine for Docker.
# BBH_DB_PATH=/app/data/bbh.db

# ── Native OOB collaborator (optional) ─────────────────────────
# Confirms blind SSRF (and future XXE) via a server-side callback. Empty = OOB
# stays advisory. Set to the agent's externally-reachable base URL so targets can
# reach /oob/<token>, e.g. https://oob.you.example
# BBH_OOB_BASE=
# Optional wildcard-DNS domain for DNS-triggerable subdomain probes (<token>.dom)
# BBH_OOB_DOMAIN=

# ── GitHub recon (optional) ────────────────────────────────────
# YOUR OWN read-only GitHub Personal Access Token (classic, no scopes required),
# used only to lift the code-search rate limit — never the target's key. Create
# one at github.com > Settings > Developer settings > Tokens. Empty = skip.
# BBH_GITHUB_TOKEN=

# ── Linode / Akamai Connected Cloud posture (optional) ─────────
# YOUR OWN read-only Linode API v4 token, used for a live cloud hardening review
# of your account at GET /cloud/posture/linode (GET-only: users/grants, cloud
# firewalls, object-storage buckets, managed databases, instances — no writes, no
# exploitation). Create a READ-ONLY token at cloud.linode.com > Profile > API
# Tokens (set every scope to Read Only, or None). Empty = the live pull is skipped.
# Keep it in .env only (gitignored) — never commit it.
# LINODE_TOKEN=

# ── OWASP ZAP DAST (optional) ──────────────────────────────────
# Leave ZAP_ADDR empty to disable the run_zap tool (it skips cleanly).
# To enable: set ZAP_ADDR below, then start with the zap profile:
#   docker compose --profile zap up -d
# ZAP_ADDR=http://zap:8090
ZAP_API_KEY=bbh-zap
