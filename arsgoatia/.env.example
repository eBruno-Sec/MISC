# =============================================================================
# ArsGoatia local development configuration
# =============================================================================
# Copy to .env before `docker compose up`. Host port mappings (see
# docker-compose.yml) are chosen to avoid the repo's existing 3000/8000:
#   api  -> http://localhost:8080     web -> http://localhost:3100
#   temporal-ui -> http://localhost:8088   minio console -> http://localhost:9101
# In-container service names/ports below stay spec-default.

APP_ENV=development
APP_NAME=ArsGoatia
APP_URL=http://localhost:3100
API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database  (host port 5433 -> container 5432)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://arsgoatia:arsgoatia@postgres:5432/arsgoatia
POSTGRES_USER=arsgoatia
POSTGRES_PASSWORD=arsgoatia
POSTGRES_DB=arsgoatia

# -----------------------------------------------------------------------------
# Temporal
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_CONTROL=workflow-control

# -----------------------------------------------------------------------------
# Object storage (MinIO; host ports 9100 API / 9101 console)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=arsgoatia-evidence
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# AI provider (optional; blank AI_API_KEY disables AI, pipeline stays deterministic)
# -----------------------------------------------------------------------------
AI_PROVIDER=openrouter
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_FALLBACK_MODELS=openrouter/free

AI_PLANNER_MODEL=${AI_MODEL}
AI_HYPOTHESIS_MODEL=${AI_MODEL}
AI_REPORT_MODEL=${AI_MODEL}
AI_NORMALIZER_MODEL=${AI_MODEL}

AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=8
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.1

AI_APP_NAME=ArsGoatia
AI_APP_URL=http://localhost:3100

AI_SEND_RAW_SECRETS=false
AI_SEND_RAW_EVIDENCE=false
AI_REDACT_PROMPTS=true
AI_STORE_PROMPTS=false
AI_STORE_RESPONSES=false
AI_REQUIRE_STRUCTURED_OUTPUT=true

AI_DAILY_BUDGET_USD=10
AI_ASSESSMENT_BUDGET_USD=5
AI_REQUEST_BUDGET_USD=1

# -----------------------------------------------------------------------------
# Eventing  (repo substitution: PostgreSQL transactional outbox instead of NATS)
# -----------------------------------------------------------------------------
EVENT_BUS_DRIVER=postgres_outbox
# NATS_URL=nats://nats:4222   # future: swap driver behind the same event envelope

# -----------------------------------------------------------------------------
# Authentication  (SESSION_SECRET also derives the dev HMAC envelope-signing key)
# -----------------------------------------------------------------------------
AUTH_MODE=local
SESSION_SECRET=replace-me-dev-only
COOKIE_SECURE=false
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Policy defaults
# -----------------------------------------------------------------------------
DEFAULT_POLICY_PROFILE=lab-safe
PRODUCTION_DEFAULT_DENY_MUTATION=true
REQUIRE_AUTHORIZATION_RECORD=true
REQUIRE_EXPLICIT_SCOPE=true
MAX_GLOBAL_CONCURRENT_ASSESSMENTS=5
MAX_CONCURRENT_MODULES_PER_ASSESSMENT=10
DEFAULT_MAX_REQUESTS_PER_MODULE=500
DEFAULT_MAX_RPS=2
DEFAULT_CHAIN_DEPTH=8

# -----------------------------------------------------------------------------
# Evidence
# -----------------------------------------------------------------------------
EVIDENCE_REQUIRE_HASH=true
EVIDENCE_DEFAULT_SENSITIVITY=confidential
EVIDENCE_ENABLE_OBJECT_LOCK=false
EVIDENCE_MAX_ARTIFACT_BYTES=104857600

# -----------------------------------------------------------------------------
# Logging and telemetry
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REDACT_SECRETS=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# -----------------------------------------------------------------------------
# Lab target (profile: lab)
# -----------------------------------------------------------------------------
LAB_TARGET=juice-shop:3000
