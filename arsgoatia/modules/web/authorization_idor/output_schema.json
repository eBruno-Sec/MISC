{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "web.authorization.idor output",
  "type": "object",
  "required": ["module_id", "module_version", "schema_version", "provenance"],
  "properties": {
    "module_id": {"const": "web.authorization.idor"},
    "module_version": {"type": "string"},
    "schema_version": {"type": "integer", "minimum": 1},
    "provenance": {
      "type": "object",
      "required": ["module_id", "module_version", "parser_version"],
      "properties": {
        "module_id": {"type": "string"},
        "module_version": {"type": "string"},
        "parser_version": {"type": "string"},
        "tool_execution_ids": {"type": "array", "items": {"type": "string"}},
        "confirmation_rule_version": {"type": ["string", "null"]}
      }
    },
    "observations": {"type": "array", "items": {"type": "object"}},
    "hypotheses": {"type": "array", "items": {"type": "object"}},
    "candidate_findings": {"type": "array", "items": {"type": "object"}},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability_type": {"type": "string"},
          "label": {"type": "string"},
          "validation_state": {"type": "string"}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
