# Database
DB_NAME=yggdrasil
DB_USER=yggdrasil
DB_PASSWORD=yggdrasil_secret
SECRET_KEY=change-me-use-openssl-rand-hex-32

# AI Provider
# Choose one: anthropic | openrouter
# Leave AI_API_KEY blank to disable AI features. Recon and scanning still work.
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-sonnet-4-6

# OpenRouter example
#AI_PROVIDER=openrouter
#AI_API_KEY=sk-or-your-key-here
#AI_MODEL=anthropic/claude-sonnet-4-6
#AI_BASE_URL=https://openrouter.ai/api/v1

# Access control
# Set a strong key to require X-API-Key on every /api and /ws request.
# Leave blank only for single-user localhost.
YGGDRASIL_API_KEY=

# Legacy fallback. Existing installs can keep using this.
OLYMPUS_API_KEY=

# Comma-separated allowed browser origins for the API.
CORS_ORIGINS=http://localhost:3000

# Runtime controls
# Set true/1/yes to pre-authorize all HITL gates globally. Per-mission launch switch is preferred.
YGGDRASIL_AUTO_APPROVE=
# 0 waits indefinitely for approval. Positive seconds auto-denies after timeout.
YGGDRASIL_APPROVAL_TIMEOUT=0
# Active scan safety caps.
YGGDRASIL_OFFENSIVE_MAX_HOSTS=5
YGGDRASIL_CIDR_MAX_HOSTS=1024
# Heartbeat interval in seconds. 0 disables.
YGGDRASIL_HEARTBEAT_SECONDS=300