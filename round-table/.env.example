# ════════════════════════════════════════════════════════════════════
# ROUND TABLE // environment
# Copy to .env and edit. Everything here is OPTIONAL — with no changes at
# all, `docker compose up` gives you a fully working, rule-based platform.
# ════════════════════════════════════════════════════════════════════

# Port on your host to reach the dashboard (http://localhost:<PORT>)
ROUNDTABLE_PORT=3000

# ── AI (optional) ──────────────────────────────────────────────────────
# Round Table's guidance engine is 100% rule-based and needs NO AI.
# Add a key only if you want an AI executive-summary/attack-chain narrative.
#
# OpenRouter (one key, any model — free models available):
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_BASE_URL=https://openrouter.ai/api/v1
#
# Other free OpenRouter models you can drop into AI_MODEL:
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   openrouter/auto
#
# Anthropic direct (alternative provider):
#AI_PROVIDER=anthropic
#AI_API_KEY=sk-ant-...
#AI_MODEL=claude-sonnet-4-6

# ── scan tuning (optional) ─────────────────────────────────────────────
ROUNDTABLE_THREADS=10
ROUNDTABLE_HTTP_TIMEOUT=8
ROUNDTABLE_NUCLEI_SEVERITY=medium,high,critical
ROUNDTABLE_PORTS=80,443,8080,8443,8888,3000,5000,9090,9200,27017,6379,5432,3306,2375,5601
