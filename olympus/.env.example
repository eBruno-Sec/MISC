# ── Database ──────────────────────────────────────────────────
DB_USER=olympus
DB_PASSWORD=olympus_secret
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── AI Provider ───────────────────────────────────────────────
# Choose one: anthropic | openrouter
# Leave AI_API_KEY blank to disable AI features (recon/scanning still works fully).

AI_PROVIDER=anthropic

# Anthropic (default)
# Get key: https://console.anthropic.com/
AI_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-sonnet-4-6

# OpenRouter (uncomment to switch)
# Get key: https://openrouter.ai/keys
# Full model list: https://openrouter.ai/models
#AI_PROVIDER=openrouter
#AI_API_KEY=sk-or-your-key-here
#AI_MODEL=anthropic/claude-sonnet-4-6
#AI_BASE_URL=https://openrouter.ai/api/v1

# Other self-hosted / proxy (any OpenAI-compatible endpoint)
#AI_PROVIDER=openrouter
#AI_API_KEY=your-key
#AI_MODEL=your-model-name
#AI_BASE_URL=http://localhost:11434/v1

# ── Access control ────────────────────────────────────────────
# Set a strong key to require X-API-Key on every /api and /ws request.
# Leave blank ONLY for single-user localhost. setup.sh can generate one.
# When set, tell the web UI the key once from the browser devtools console:
#   localStorage.setItem('olympus_api_key', '<the same key>')
# (the UI then sends it on REST and WebSocket calls; without this the UI 401s).
OLYMPUS_API_KEY=

# Comma-separated allowed browser origins for the API.
CORS_ORIGINS=http://localhost:3000

# ── Scanning ──────────────────────────────────────────────────
# How many live hosts get the full spider + OWASP ZAP active scan per mission.
# Each host is a heavy active scan, so raise this only when you have time.
OLYMPUS_OFFENSIVE_MAX_HOSTS=5

# HITL approval gate timeout, in seconds. 0 = wait forever for you to click
# AUTHORIZE/DENY (the mission pauses indefinitely, never auto-denies). Set a
# positive value (e.g. 600) to auto-deny and fall through to a report.
OLYMPUS_APPROVAL_TIMEOUT=0

# OWASP ZAP daemon API key (must match the zap service in docker-compose.yml).
ZAP_API_KEY=olympus-zap
