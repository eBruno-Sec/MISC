# ── AI Provider ────────────────────────────────────────────────
# Set to "anthropic" or "openrouter"
AI_PROVIDER=openrouter

# ── OpenRouter (free models available) ─────────────────────────
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Free models that support tool calling:
#   meta-llama/llama-3.3-70b-instruct:free   (best free option)
#   google/gemini-2.0-flash-exp:free
#   qwen/qwen3-235b-a22b:free
#
# Paid models (better triage, ~$0.01-0.05/run):
#   anthropic/claude-sonnet-4-6
#   openai/gpt-4o
#   google/gemini-2.5-pro
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Anthropic (paid, ~$0.50-1.50/run) ──────────────────────────
# Only required if AI_PROVIDER=anthropic
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── HITL intrusive-gate timeout ────────────────────────────────
# Seconds before an unanswered intrusive-probing approval auto-denies.
# 0 = wait forever (default). Set e.g. 300 for a 5-minute auto-deny.
BBH_APPROVAL_TIMEOUT=0

# ── Persistence ────────────────────────────────────────────────
# SQLite database path (mounted volume). Default is fine for Docker.
# BBH_DB_PATH=/app/data/bbh.db

# ── Native OOB collaborator (optional) ─────────────────────────
# Confirms blind SSRF (and future XXE) via a server-side callback. Empty = OOB
# stays advisory. Set to the agent's externally-reachable base URL so targets can
# reach /oob/<token>, e.g. https://oob.you.example
# BBH_OOB_BASE=
# Optional wildcard-DNS domain for DNS-triggerable subdomain probes (<token>.dom)
# BBH_OOB_DOMAIN=

# ── GitHub recon (optional) ────────────────────────────────────
# YOUR OWN read-only GitHub Personal Access Token (classic, no scopes required),
# used only to lift the code-search rate limit — never the target's key. Create
# one at github.com > Settings > Developer settings > Tokens. Empty = skip.
# BBH_GITHUB_TOKEN=

# ── OWASP ZAP DAST (optional) ──────────────────────────────────
# Leave ZAP_ADDR empty to disable the run_zap tool (it skips cleanly).
# To enable: set ZAP_ADDR below, then start with the zap profile:
#   docker compose --profile zap up -d
# ZAP_ADDR=http://zap:8090
ZAP_API_KEY=bbh-zap
